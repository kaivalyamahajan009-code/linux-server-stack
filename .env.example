# Copy to .env and replace the passwords (openssl rand -hex 24 works well).
# Keep values without quotes or spaces, this file is also read by docker compose.

COMPOSE_PROJECT_NAME=linux-server-stack

POSTGRES_DB=server_audit
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
GRAFANA_DB_READER_PASSWORD=change_me

DOCKER_DATA_ROOT=/var/lib/docker
BACKUP_DIR=/var/backups/linux-server-stack
BACKUP_KEEP_COUNT=7
TEXTFILE_DIR=/var/lib/linux-server-stack/textfile
