{
  "annotations": { "list": [] },
  "description": "Monitors container CPU, memory working set, and uptime via cAdvisor. Note: Core stack containers run with host networking, so network metrics represent shared host traffic.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Running Containers",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      },
      "targets": [
        {
          "expr": "count(container_last_seen{name=~\"[a-zA-Z0-9_-]+\", name!=\"\"})",
          "legendFormat": "Running Containers",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Container CPU Utilization",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "drawStyle": "line" }
        }
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"[a-zA-Z0-9_-]+\", name!=\"\"}[2m]) * 100",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Container Memory Working Set",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line" }
        }
      },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{name=~\"[a-zA-Z0-9_-]+\", name!=\"\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Container Uptime / Age",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "dtduration_s",
          "custom": { "drawStyle": "line" }
        }
      },
      "targets": [
        {
          "expr": "time() - container_start_time_seconds{name=~\"[a-zA-Z0-9_-]+\", name!=\"\"}",
          "legendFormat": "{{name}} Uptime",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["containers", "cadvisor", "linux-server-stack"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": { "refresh_intervals": ["10s", "30s", "1m", "5m"] },
  "timezone": "browser",
  "title": "Container Overview",
  "uid": "container-overview"
}
